# Priors secrets. Copy to .env and fill in. Never commit .env.
# Everything editorial lives in config.yaml; only secrets belong here.

# --- Required from Phase 1 ---

# Anthropic API key — composes the issue. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Resend API key — sends the email. Free tier: 100 emails/day. https://resend.com/api-keys
RESEND_API_KEY=

# GNews API key — news search beyond RSS. Free tier: 100 req/day. https://gnews.io
GNEWS_API_KEY=

# --- Optional (Phase 2, prediction markets) ---

# Kalshi API credentials — https://kalshi.com (Polymarket and Metaculus need no key for reads)
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY=
